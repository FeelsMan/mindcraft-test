  "scripts": {
    "postinstall": "node scripts/install-native-minecraft.cjs && patch-package",
    "start": "node main.js",
    "reinstall": "npm run clean:modules && npm install",
    "clean:modules": "node -e \"const fs=require('fs');const p=require('path');['node_modules','package-lock.json'].forEach(f=>{if(fs.existsSync(f)){if(fs.lstatSync(f).isDirectory()){fs.rmSync(f,{recursive:true,force:true});}else{fs.unlinkSync(f);}}});\"",
    "test:goals": "node --experimental-test-module-mocks --test test/managed-goals.test.js test/crafting-station.test.js test/mining-navigation.test.js test/command-policy.test.js test/agent-command-loop.test.js test/local-memory.test.js test/memory-prompt.test.js test/action-interrupt.test.js test/agent-process.test.js test/resource-recovery.test.js test/managed-smelting.test.js test/smelting-commands.test.js test/station-access.test.js test/grounded-crafting.test.js test/crafting-commands.test.js test/crafting-results.test.js test/make-goal-completion.test.js test/crafting-installer.test.cjs"
  },
  "devDependencies": {
    "patch-package": "^8.0.0"
  },
  "miaNativeMinecraft": {
    "version": "26.3",
    "experimental": true,
    "protocol": 777
  }
